rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    match /qr_codes/{qrId} {
      allow read: if true;
      allow write: if true;
    }

    match /platform_settings/{docId} {
      allow read, write: if true;
    }
  }
}
